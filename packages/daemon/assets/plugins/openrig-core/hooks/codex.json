{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" activity",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" activity",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" refocus",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" activity",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" refocus",
            "timeout": 60
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'hooks/scripts/codex-entry.cjs'))\" activity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
